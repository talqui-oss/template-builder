{
  "packageFiles": ["packages/template-builder/package.json"],
  "bumpFiles": [
    "packages/template-builder/package.json",
    "packages/template-builder-react/package.json",
    "packages/template-builder-vue/package.json"
  ],
  "types": [
    { "type": "feat", "section": "Features" },
