{
  "name": "@talqui-oss/template-builder",
  "version": "0.0.0",
  "description": "Preview, validate and create WhatsApp message templates",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/talqui-oss/template-builder.git",
    "directory": "packages/template-builder"
  },
  "homepage": "https://template-builder.dev",
  "keywords": [
    "whatsapp",
    "templates",
    "message-templates",
    "preview",
    "validation"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./schema.json": "./dist/schema.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && pnpm schema",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "schema": "ts-json-schema-generator --path src/schema/types.ts --type Template --no-type-check --out dist/schema.json"
  },
  "devDependencies": {
    "@template-builder/tsconfig": "workspace:*",
    "ts-json-schema-generator": "^2.9.0",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3"
  }
}
