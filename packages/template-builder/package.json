{
  "name": "@talqui-oss/template-builder",
  "version": "0.0.0",
  "description": "Preview, validate and create WhatsApp message templates",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/talqui-oss/template-builder.git",
    "directory": "packages/template-builder"
  },
  "homepage": "https://template-builder.dev",
  "keywords": [
    "whatsapp",
    "templates",
    "message-templates",
    "preview",
    "validation"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./adapters/meta": {
      "import": "./dist/adapters/meta.js",
      "require": "./dist/adapters/meta.cjs"
    },
    "./adapters/twilio": {
      "import": "./dist/adapters/twilio.js",
      "require": "./dist/adapters/twilio.cjs"
    },
    "./adapters/talqui": {
      "import": "./dist/adapters/talqui.js",
      "require": "./dist/adapters/talqui.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./schema.json": "./dist/schema.json",
    "./editor.css": "./dist/editor.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && pnpm schema && cp src/preview/styles.css dist/styles.css && cp src/editor/editor.css dist/editor.css",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "schema": "ts-json-schema-generator --path src/schema/types.ts --type Template --id https://template-builder.dev/schema.json --no-type-check --out dist/schema.json"
  },
  "devDependencies": {
    "@template-builder/tsconfig": "workspace:*",
    "ts-json-schema-generator": "^2.9.0",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3"
  }
}
